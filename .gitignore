# --- secrets (never commit) ---
.env

# --- python ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- node (worker/index.js's one dependency) ---
# node_modules is never committed — Cloudflare's own build installs it fresh
# at deploy time. package-lock.json, if one gets generated (e.g. running
# `npm install` locally to test the worker), SHOULD be committed for a
# reproducible install — it's deliberately not listed here.
node_modules/

# --- local editor / tooling config ---
.claude/

# --- personal working files, kept out of the public repo ---
# Design/planning notes and the standalone prototype. Not secret, but personal
# (career context, brainstorming). Remove a line here if you decide to publish
# it as part of the portfolio story.
*brainstorm*.md
beam-build-brief.md
app-shell-cool.html
app-shell-cool-update.html
sample-screenings-clean.json
